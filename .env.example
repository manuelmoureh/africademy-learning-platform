# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: from Supabase Dashboard > Project Settings > API.
# Required for real auth, enrollments, and progress persistence.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: server-only, used by api/payments/* to write
# purchase records bypassing RLS. SUPABASE_URL is the same value as VITE_SUPABASE_URL
# above, just under a plain (non-Vite-prefixed) name so it's readable from the api/
# serverless runtime. SUPABASE_SERVICE_ROLE_KEY is from Supabase Dashboard > Project
# Settings > API > service_role secret - never expose this to the client.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_SECRET"

# PAYSTACK_SECRET_KEY: from the Paystack Dashboard > Settings > API Keys & Webhooks.
# Server-only - powers api/payments/initialize.ts, verify.ts, and webhook.ts. Use the
# test secret key (starts sk_test_) until the integration is fully verified, then swap in
# the live key (sk_live_) - same env var name, no code changes needed either way.
PAYSTACK_SECRET_KEY="sk_test_YOUR_PAYSTACK_SECRET_KEY"

# RESEND_API_KEY / RESEND_FROM_EMAIL / NOTIFY_EMAIL: admin notification emails (new
# sign-ups, payments) sent via Resend from api/_lib/resend.ts. RESEND_FROM_EMAIL must be
# on a domain verified in Resend (e.g. a subdomain like notify.afridemy.online, kept
# separate from the root domain's Google Workspace mail). NOTIFY_EMAIL is where alerts land.
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="Afridemy <alerts@notify.afridemy.online>"
NOTIFY_EMAIL="hello@afridemy.online"

# SUPABASE_WEBHOOK_SECRET: a random string you generate, checked against the
# x-webhook-secret header on the Supabase Database Webhook (Database > Webhooks) that
# calls api/notify/signup.ts on new public.profiles rows. Stops anyone else from POSTing
# fake signup events.
SUPABASE_WEBHOOK_SECRET="YOUR_RANDOM_WEBHOOK_SECRET"
